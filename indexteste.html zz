  /* ---------- 2: dados do setup ---------- */
  function viewSetup(){
    var maq=S.preMaq||null,turno=null;
    page(2,
      '<form id="fSetup" class="panel" novalidate><h2>Informações iniciais</h2><div class="meta">Operador <b>'+esc(DB.oper)+'</b>. Estes dados ficam registrados junto com o checklist.</div>'+
      '<label>Empacotadora</label><div class="seg c4" id="segMaq">'+[1,2,3,4].map(function(n){return '<button type="button" class="opt" data-maq="'+n+'" aria-pressed="'+(String(n)===String(maq))+'">'+n+'</button>';}).join('')+'</div>'+
      '<label>Turno</label><div class="seg c2" id="segTurno">'+TURNOS.map(function(t){return '<button type="button" class="opt" data-turno="'+t+'" aria-pressed="false">'+t+'</button>';}).join('')+'</div>'+
      '<div class="sub">Ordem de produção</div>'+
      '<label for="op">Número da OP <small>(6 dígitos, ou bipe o código da OP)</small></label><input id="op" type="text" inputmode="numeric" maxlength="40" class="mono" autocomplete="off">'+
      '<button type="button" class="linkbtn" id="bEx">Usar a OP de exemplo 393064</button>'+
      '<label for="itemop">Item da OP <small>(digite)</small></label><input id="itemop" type="text" class="mono" autocomplete="off">'+
      '<label for="desc">Descrição <small>(automática)</small></label><input id="desc" type="text" readonly placeholder="Aparece sozinha ao digitar o item">'+
      '<div id="itemMsg"></div>'+
      '<div id="msg"></div><div class="actions"><button class="btn primary" type="submit">Ir para o checklist</button><button type="button" class="btn ghost" id="bBack">Voltar</button></div></form>');
    function v(id){return $(id).value.trim();}
    function checkItem(){
      var it=v('itemop'),d=$('desc');
      if(!it){d.value='';d.readOnly=true;d.placeholder='Aparece sozinha ao digitar o item';$('itemMsg').innerHTML='';return null;}
      var o=cat()[it];
      if(o&&o.desc){d.readOnly=true;d.value=o.desc;$('itemMsg').innerHTML='<div class="hint good">Item encontrado na base. Os códigos esperados serão conferidos no checklist.</div>';return o;}
      d.readOnly=false;d.placeholder='Item fora da base: digite a descrição';
      $('itemMsg').innerHTML='<div class="hint">Item fora da base. Os códigos serão apenas registrados no checklist e a Qualidade confere no final.</div>';return o||{itemOp:it};
    }
    function pick(box,attr,set){$(box).addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;set(b.dataset[attr]);[].forEach.call(this.children,function(x){x.setAttribute('aria-pressed',x===b?'true':'false');});});}
    pick('segMaq','maq',function(x){maq=x;});pick('segTurno','turno',function(x){turno=x;});
    $('bEx').addEventListener('click',function(){$('op').value='393064';$('itemop').value='60693';checkItem();});
    $('op').addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();var m=(this.value.match(/\d{6}/)||[''])[0];if(m)this.value=m;$('itemop').focus();}});
    $('itemop').addEventListener('input',checkItem);
    $('bBack').addEventListener('click',function(){go('home');});
    $('fSetup').addEventListener('submit',function(e){
      e.preventDefault();
      var op=(v('op').match(/\d{6}/)||[''])[0],it=v('itemop'),err=[];
      if(!maq)err.push('escolha a empacotadora');
      if(!turno)err.push('escolha o turno');
      if(!op)err.push('informe a OP com 6 dígitos');
      if(!it)err.push('informe o item da OP');
      if(maq){var ab=openOf(maq);if(ab)err.push('a empacotadora '+maq+' já tem um checklist aberto (OP '+ab.op+'). Conclua ou cancele antes');}
      var c=it?checkItem():null;
      if(err.length){$('msg').innerHTML='<div class="hint err">Antes de avançar: '+esc(err.join('; '))+'.</div>';return;}
      if(!c.desc)c=Object.assign({},c,{desc:v('desc')});
      if(!cat()[it])saveItem({itemOp:it,desc:c.desc});
      var now=new Date();
      var t={id:stamp(now),protocolo:++DB.seq,operador:DB.oper,maq:maq,turno:turno,op:op,itemOp:it,desc:c.desc||'',bag:c.bag,caixa:c.caixa,filme:c.filme,ean:c.ean,dun:c.dun,dt:now.toISOString(),status:'andamento',ans:{},log:[],pareceres:[]};
      DB.setups.unshift(t);persist();S.id=t.id;S.back='home';go('list');
    });
  }

  /* ---------- 3: checklist ---------- */
  function codeBtn(t,c,lab){
    var a=t.ans[c],r=a?a.r:null,cls='',x='Pendente';
    if(a&&a.conf==='sem'){cls='';x='● Registrado';}else if(r==='OK'){cls=' ok';x='✓ Aprovado';}else if(r==='Não OK'||(a&&a.quality)){cls=' nok';x='✕ Reprovado';}else if(r){x=r;}
    return '<button class="code'+cls+'" data-c="'+c+'"><b>'+lab+'</b><span>'+x+'</span></button>';
  }
  function open(c){
    S.cur=c;var a=T().ans[c]||{};
    S.draft={r:a.r||null,cod:a.cod||'',conf:a.conf===undefined?null:a.conf,quality:!!a.quality,peso:a.peso||'',obs:a.obs||'',foto:a.foto||'',sem:!!a.sem};
    go('detail');
  }
  function head(t){return '<div class="meta">Protocolo <b>'+t.protocolo+'</b> · Empacotadora <b>'+esc(t.maq)+'</b> · '+esc(t.turno)+'<br>Operador <b>'+esc(t.operador)+'</b> · OP <b>'+esc(t.op)+'</b> · Item <b>'+esc(t.itemOp)+'</b><br>'+esc(t.desc)+'</div>';}
  function viewList(){
    var t=T();if(!t){go('home');return;}
    if(t.status!=='andamento'){go('view');return;}
    var n=answered(t),total=ITEMS.length,pct=Math.round(n/total*100),lockO=!othersDone(t);
    page(3,
      '<div class="panel">'+head(t)+'<div class="bar"><i style="width:'+pct+'%"></i></div><div class="count">'+n+' de '+total+' conferências</div></div>'+
      '<div class="sub">Códigos da OP</div><div class="codes" id="codes">'+codeBtn(t,'OP','OP')+codeBtn(t,'B','Bag')+codeBtn(t,'D','Caixa')+codeBtn(t,'E','Filme')+'</div>'+
      '<div class="sub">Checklist</div><ul class="items" id="items">'+ITEMS.filter(function(i){return !i.hide;}).map(function(i){
        var r=resp(i.c,t),dis=i.final&&lockO,cls=r?(r==='Não OK'||r==='Não liberado'?' nok':' done'):'';
        return '<li><button class="it'+cls+'" data-c="'+i.c+'"'+(dis?' disabled':'')+'><span class="l">'+i.c+'</span><span class="q">'+esc(i.q)+'</span>'+chipOf(t.ans[i.c])+'</button></li>';
      }).join('')+'</ul>'+
      (lockO?'<div class="hint">O item O só abre depois de conferir o código da OP e responder de A a N.</div>':'')+
      '<div class="actions"><button id="bFinish" class="btn primary"'+(canFinish(t)?'':' disabled')+'>Concluir setup</button><button id="bHome" class="btn ghost">Sair (continuar depois)</button><button id="bReset" class="btn ghost">'+(S.cancel?'Confirmar cancelamento':'Cancelar setup')+'</button></div>');
    function click(e){var b=e.target.closest('[data-c]');if(!b||b.disabled)return;open(b.dataset.c);}
    $('codes').addEventListener('click',click);$('items').addEventListener('click',click);
    $('bFinish').addEventListener('click',function(){
      var sem=Object.keys(t.ans).some(function(c){return t.ans[c].conf==='sem';});
      if(sem){t.status='analise';S.msg='sem';}else{t.status='liberado';t.fim=new Date().toISOString();S.msg='ok';}
      persist();S.flash='';S.back='home';go('view');});
    $('bHome').addEventListener('click',function(){go('home');});
    $('bReset').addEventListener('click',function(){
      if(!S.cancel){S.cancel=true;render();return;}
      DB.setups=DB.setups.filter(function(x){return x.id!==t.id;});persist();S.id=null;go('home');});
  }

  /* ---------- item ---------- */
  function viewDetail(){
    var t=T(),i=item(S.cur),d=S.draft,sc=i.scan,list=sc?expList(sc,t):[];
    var opts=i.final?[['Liberado para produção','good'],['Não liberado','bad']]:[['OK','good'],['Não OK','bad'],['Não se aplica','']];
    var h='<button class="back" id="bBack">‹ Voltar ao checklist</button><div class="panel"><div class="meta">'+(i.hide?'Código da OP':'Item <b>'+i.c+'</b>')+'</div><h2 style="font-size:1.2rem;font-weight:600">'+esc(i.q)+'</h2>';
    if(sc){
      h+='<label for="cod">'+esc(sc.lab)+' <small>('+esc(sc.hint)+')</small></label>'+
        '<div class="scanbox"><input id="cod" type="text" class="mono" autocomplete="off" autocapitalize="off" value="'+esc(d.cod)+'"><button type="button" class="btn dark" id="bCheck">Conferir</button></div>';
      if(d.conf==='sem')h+='<div class="res" style="background:var(--warn-bg);color:var(--warn)"><span class="stamp">Registrado</span><span>lido <span class="lido">'+esc(d.cod)+'</span>. Sem referência na base: a Qualidade confere no final.</span></div>';
      if(d.conf===true)h+='<div class="res good"><span class="stamp">Aprovado</span><span>lido <span class="lido">'+esc(d.cod)+'</span></span></div>';
      if(d.conf===false)h+='<div class="res err"><span class="stamp">Reprovado</span><span>lido <span class="lido">'+esc(d.cod)+'</span>. Este código não é o da OP.</span>'+
        '<div class="seg c2 full" style="margin-top:6px"><button type="button" class="opt" id="bRetry">Tentar novamente</button><button type="button" class="opt bad" aria-pressed="true" id="bQual">Acionar a Qualidade</button></div></div>';
    }
    h+='<label>Resposta</label><div class="seg '+(opts.length===2?'c2':'c3')+'" id="segR">'+opts.map(function(o){return '<button type="button" class="opt '+o[1]+'" data-r="'+esc(o[0])+'" aria-pressed="'+(d.r===o[0])+'">'+esc(o[0])+'</button>';}).join('')+'</div>';
    if(i.peso)h+='<label for="peso">Peso real da caixa completa <small>(kg)</small></label><input id="peso" type="number" inputmode="decimal" step="0.01" class="mono" value="'+esc(d.peso)+'">';
    h+='<label for="foto">Foto '+(i.foto?'da etiqueta colada':'<small>(opcional)</small>')+'</label><input id="foto" type="file" accept="image/*" capture="environment">';
    var th=S.thumbs[t.id+S.cur];
    if(th)h+='<img class="thumb" alt="Foto do item '+i.c+'" src="'+th+'">';
    else if(d.foto)h+='<div class="hint good">Foto registrada: '+esc(d.foto)+'</div>';
    if(i.foto)h+='<div class="chk"><input id="sem" type="checkbox"'+(d.sem?' checked':'')+'><label for="sem">Não utilizei etiqueta</label></div>';
    h+='<label for="obs">Observações <small>(opcional)</small></label><textarea id="obs">'+esc(d.obs)+'</textarea>'+
      (S.msg?'<div class="hint err">'+esc(S.msg)+'</div>':'')+
      '<div class="actions"><button class="btn primary" id="bSave">Salvar e voltar</button></div></div>';
    page(3,h);
    function grab(){if($('cod'))d.cod=$('cod').value.trim();if($('peso'))d.peso=$('peso').value;if($('obs'))d.obs=$('obs').value;if($('sem'))d.sem=$('sem').checked;}
    function check(){
      grab();if(!d.cod){S.msg='Bipe ou digite o código.';render();return;}
      var ok=matches(d.cod,list)?true:(semRef(sc,t)?null:false);
      t.log.push({c:i.c,lido:d.cod,esp:list.join(' ou '),ok:ok,em:new Date().toISOString(),operador:DB.oper});
      d.conf=ok===null?'sem':ok;S.msg='';if(ok===true){d.quality=false;d.r='OK';}persist();render();
    }
    $('bBack').addEventListener('click',function(){go('list');});
    $('segR').addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;grab();d.r=b.dataset.r;if(d.r!=='Não OK')d.quality=false;S.msg='';render();});
    $('foto').addEventListener('change',function(){grab();var f=this.files&&this.files[0];if(f){d.foto=f.name;try{S.thumbs[t.id+S.cur]=URL.createObjectURL(f);}catch(e){}S.msg='';render();}});
    if(sc){
      $('bCheck').addEventListener('click',check);
      $('cod').addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();check();}});
      if(!d.cod)setTimeout(function(){var el=$('cod');if(el)el.focus();},50);
      var rt=$('bRetry');if(rt)rt.addEventListener('click',function(){d.cod='';d.conf=null;d.r=null;d.quality=false;render();setTimeout(function(){var el=$('cod');if(el)el.focus();},50);});
      var q=$('bQual');if(q)q.addEventListener('click',function(){grab();
        t.ans[S.cur]={r:'Não OK',cod:d.cod,conf:false,quality:true,peso:d.peso,obs:d.obs,foto:d.foto,sem:d.sem,em:new Date().toISOString()};
        t.status='analise';persist();S.flash='';S.back='home';go('view');});
    }
    $('bSave').addEventListener('click',function(){
      grab();var err='';
      if(!d.r)err='Escolha a resposta.';
      else if(sc&&d.r==='OK'&&!d.cod)err='Confira o código antes de responder OK.';
      else if(sc&&d.r==='OK'&&d.conf!==true&&d.conf!=='sem')err='O código ainda não foi aprovado na conferência.';
      else if(i.peso&&d.r==='OK'&&(d.peso===''||isNaN(parseFloat(d.peso))))err='Informe o peso real da caixa.';
      else if(i.foto&&d.r==='OK'&&!d.foto&&!d.sem)err='Anexe a foto da etiqueta ou marque que não utilizou etiqueta.';
      if(err){S.msg=err;render();return;}
      t.ans[S.cur]={r:d.r,cod:d.cod,conf:d.conf,quality:d.quality&&d.r==='Não OK',peso:d.peso,obs:d.obs,foto:d.foto,sem:d.sem,em:new Date().toISOString()};
      if(d.r==='Não liberado')t.status='analise';
      persist();S.back='home';go(t.status==='andamento'?'list':'view');
    });
  }

  /* ---------- consultar (lista com busca, como no Retrabalho) ---------- */
  function rowsHtml(){
