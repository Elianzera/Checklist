<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Checklist Setup Empacotadoras</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#f3f1ea;--card:#ffffff;--ink:#1c1e22;--mute:#5b5f67;--line:#d9d5c9;--edge:#8d897d;--field:#faf9f5;
  --acc:#c4101b;--accfill:#c4101b;--accbg:#fbe8e9;
  --ok:#17692f;--ok-bg:#e1f2e6;--bad:#a30b14;--bad-bg:#fbe3e4;--warn:#774c00;--warn-bg:#fff0cb;
  --fh:'Barlow Semi Condensed',system-ui,sans-serif;--f:'IBM Plex Sans',system-ui,sans-serif;--fm:'IBM Plex Mono',ui-monospace,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#131416;--card:#1d1f23;--ink:#eceef1;--mute:#a1a6ae;--line:#34373d;--edge:#6d717a;--field:#17181b;
    --acc:#ff6b72;--accbg:#3a1a1c;--ok:#7ddb96;--ok-bg:#15301c;--bad:#ff9fa4;--bad-bg:#3b1719;--warn:#f2c970;--warn-bg:#33290f;
  }
}
:root[data-theme="dark"]{
  --paper:#131416;--card:#1d1f23;--ink:#eceef1;--mute:#a1a6ae;--line:#34373d;--edge:#6d717a;--field:#17181b;
  --acc:#ff6b72;--accbg:#3a1a1c;--ok:#7ddb96;--ok-bg:#15301c;--bad:#ff9fa4;--bad-bg:#3b1719;--warn:#f2c970;--warn-bg:#33290f;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--f);font-size:16px;line-height:1.45}
.wrap{max-width:560px;margin:0 auto;padding:16px 16px 56px}
button{font-family:inherit;font-size:inherit;cursor:pointer}
button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #f2a900;outline-offset:2px}

/* cabeçalho de formulário */
.doc{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;border-bottom:3px solid var(--ink);padding-bottom:12px}
.doc .co{font-family:var(--fh);font-weight:700;font-style:italic;color:var(--acc);letter-spacing:.5px;font-size:.95rem}
.doc h1{margin:2px 0 0;font-family:var(--fh);font-weight:700;font-size:1.6rem;line-height:1.05;text-transform:uppercase}
.doc .code{font-family:var(--fm);font-size:.72rem;color:var(--mute);text-align:right;white-space:nowrap}

/* trilho de etapas */
.steps{list-style:none;margin:14px 0 6px;padding:0;display:flex;gap:6px}
.steps li{flex:1;border-top:5px solid var(--line);padding-top:7px;font-family:var(--fh);font-weight:600;font-size:.95rem;text-transform:uppercase;letter-spacing:.6px;color:var(--mute);display:flex;align-items:center;gap:7px}
.steps li i{font-style:normal;font-family:var(--fm);font-size:.72rem;width:20px;height:20px;border:1.5px solid currentColor;border-radius:50%;display:inline-flex;align-items:center;justify-content:center}
.steps li.cur{border-top-color:var(--acc);color:var(--ink)}
.steps li.cur i{background:var(--acc);border-color:var(--acc);color:#fff}
.steps li.done{border-top-color:var(--ink);color:var(--ink)}

.note{margin:14px 0 0;padding:10px 12px;background:var(--warn-bg);color:var(--warn);font-size:.85rem;border-radius:3px}
.panel{background:var(--card);border:1px solid var(--line);border-left:5px solid var(--acc);border-radius:3px;padding:18px;margin-top:14px}
.panel h2{margin:0 0 4px;font-family:var(--fh);font-weight:700;font-size:1.4rem}
.meta{color:var(--mute);font-size:.88rem}
.meta b{color:var(--ink);font-weight:600}
.back{background:none;border:0;color:var(--mute);font-weight:500;min-height:44px;padding:0;margin-top:6px}

label{display:block;font-weight:600;font-size:.9rem;margin:16px 0 6px}
label small{font-weight:400;color:var(--mute)}
input[type=text],input[type=number],textarea{width:100%;border:1.5px solid var(--edge);border-radius:3px;background:var(--field);color:var(--ink);font:inherit;padding:11px 12px;min-height:48px}
input.mono{font-family:var(--fm)}
input[readonly]{background:transparent;border-style:dashed;color:var(--mute)}
textarea{min-height:76px}
input[type=file]{width:100%;font:inherit;color:var(--ink);padding:10px 0}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.scanbox{display:flex;gap:8px}.scanbox input{flex:1}

.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;border:1.5px solid var(--ink);border-radius:3px;background:var(--card);color:var(--ink);font-family:var(--fh);font-weight:700;font-size:1.05rem;text-transform:uppercase;letter-spacing:.6px}
.btn.primary{background:var(--accfill);border-color:var(--accfill);color:#fff}
.btn.dark{background:var(--ink);color:var(--paper)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.ghost{border-color:var(--edge);color:var(--mute)}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.linkbtn{background:none;border:0;color:var(--acc);font-weight:600;min-height:44px;padding:0}

.seg{display:grid;gap:8px;margin-top:2px}
.c2{grid-template-columns:1fr 1fr}.c3{grid-template-columns:repeat(3,1fr)}.c4{grid-template-columns:repeat(4,1fr)}
.opt{min-height:48px;border:1.5px solid var(--edge);border-radius:3px;background:var(--card);color:var(--ink);font-weight:600;padding:0 6px}
.opt[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:var(--paper)}
.opt.good[aria-pressed=true]{background:var(--ok);border-color:var(--ok);color:#fff}
.opt.bad[aria-pressed=true]{background:var(--acc);border-color:var(--acc);color:#fff}
:root[data-theme="dark"] .opt.good[aria-pressed=true],:root[data-theme="dark"] .opt.bad[aria-pressed=true]{color:#111}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .opt.good[aria-pressed=true],:root:not([data-theme="light"]) .opt.bad[aria-pressed=true]{color:#111}}

.hint{margin-top:14px;padding:10px 12px;border-radius:3px;font-size:.88rem;background:var(--warn-bg);color:var(--warn)}
.hint.err{background:var(--bad-bg);color:var(--bad)}
.hint.good{background:var(--ok-bg);color:var(--ok)}
.res{margin-top:14px;padding:14px;border-radius:3px;display:flex;flex-wrap:wrap;align-items:center;gap:10px}
.res.good{background:var(--ok-bg);color:var(--ok)}
.res.err{background:var(--bad-bg);color:var(--bad)}
.res .lido{font-family:var(--fm);color:var(--ink)}
.res .full{flex-basis:100%}
.stamp{display:inline-block;font-family:var(--fm);font-weight:500;font-size:.85rem;letter-spacing:1.5px;border:2px solid currentColor;padding:2px 8px;border-radius:3px;transform:rotate(-2deg);text-transform:uppercase;white-space:nowrap}

/* faixa de códigos */
.sub{font-family:var(--fh);font-weight:600;font-size:.95rem;text-transform:uppercase;letter-spacing:1px;color:var(--mute);margin:20px 0 8px}
.codes{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
@media (max-width:400px){.codes{grid-template-columns:repeat(2,1fr)}}
.code{border:1.5px solid var(--edge);border-radius:3px;background:var(--card);color:var(--ink);padding:8px 10px;text-align:left;min-height:62px}
.code b{display:block;font-family:var(--fh);font-size:1.1rem;text-transform:uppercase}
.code span{font-size:.75rem;color:var(--mute)}
.code.ok{border-color:var(--ok);background:var(--ok-bg)}.code.ok span{color:var(--ok);font-weight:600}
.code.nok{border-color:var(--acc);background:var(--bad-bg)}.code.nok span{color:var(--bad);font-weight:600}

.bar{height:8px;background:var(--line);border-radius:2px;overflow:hidden;margin-top:12px}
.bar i{display:block;height:100%;background:var(--ink)}
.count{font-family:var(--fm);font-size:.78rem;color:var(--mute);margin-top:4px}
ul.items{list-style:none;margin:8px 0 0;padding:0}
.it{width:100%;display:flex;align-items:center;gap:12px;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:3px;padding:11px 12px;margin-top:8px;color:var(--ink);min-height:58px}
.it:disabled{opacity:.5;cursor:not-allowed}
.it .l{flex:none;width:32px;height:32px;border-radius:3px;background:var(--ink);color:var(--paper);font-family:var(--fm);font-weight:500;display:flex;align-items:center;justify-content:center}
.it.done .l{background:var(--ok);color:#fff}
.it.nok .l{background:var(--acc);color:#fff}
.it .q{flex:1;font-size:.86rem}
.chip{flex:none;font-family:var(--fm);font-size:.68rem;font-weight:500;padding:3px 8px;border-radius:3px;background:var(--line);color:var(--mute);white-space:nowrap;text-transform:uppercase}
.chip.ok{background:var(--ok-bg);color:var(--ok)}.chip.nok{background:var(--bad-bg);color:var(--bad)}.chip.na{background:var(--warn-bg);color:var(--warn)}
.thumb{max-width:100%;border-radius:3px;margin-top:10px}
.chk{display:flex;gap:10px;align-items:center;margin-top:12px}.chk input{width:22px;height:22px}.chk label{margin:0;font-weight:400}
.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:.84rem}
th{text-align:left;font-family:var(--fh);text-transform:uppercase;letter-spacing:.6px;font-size:.78rem;color:var(--mute);padding:6px 4px;border-bottom:2px solid var(--ink)}
td{padding:8px 4px;border-bottom:1px solid var(--line);vertical-align:top}
.mono{font-family:var(--fm)}
.hrow{width:100%;text-align:left;display:flex;justify-content:space-between;gap:10px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:3px;padding:12px;margin-top:8px;color:var(--ink);min-height:60px}
.hrow b{font-family:var(--fm);font-weight:500}
.kv{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;margin-top:10px;font-size:.9rem}
.kv dt{color:var(--mute)}.kv dd{margin:0;font-weight:500}

.who{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:.9rem}
.who .sp{flex:1}
.mach{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.mc{text-align:left;border:1.5px solid var(--edge);border-left-width:6px;border-radius:3px;background:var(--card);color:var(--ink);padding:10px 12px;min-height:78px}
.mc b{font-family:var(--fh);text-transform:uppercase;font-size:1.05rem;display:block}
.mc span{font-size:.78rem;color:var(--mute);display:block;line-height:1.3}
.mc.free{border-left-color:var(--ok)}.mc.busy{border-left-color:var(--ink)}.mc.an{border-left-color:var(--acc);background:var(--bad-bg)}
.menu{display:grid;gap:10px}
.mbtn{display:flex;align-items:center;gap:14px;min-height:64px;border:1.5px solid var(--ink);border-radius:3px;background:var(--card);color:var(--ink);padding:0 16px;font-family:var(--fh);font-weight:700;font-size:1.2rem;text-transform:uppercase;letter-spacing:.6px;text-align:left;width:100%}
.mbtn.primary{background:var(--accfill);border-color:var(--accfill);color:#fff}
.mbtn svg{width:26px;height:26px;flex:none}
.badge{margin-left:auto;min-width:28px;height:28px;border-radius:14px;background:var(--acc);color:#fff;font-family:var(--fm);font-size:.85rem;display:inline-flex;align-items:center;justify-content:center;padding:0 8px}
.badge.zero{background:var(--line);color:var(--mute)}
.filters{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}
.fchip{min-height:40px;padding:0 12px;border:1.5px solid var(--edge);border-radius:20px;background:var(--card);color:var(--ink);font-weight:600;font-size:.85rem}
.fchip[aria-pressed=true]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.hrow .tx{font-size:.84rem;line-height:1.35}
.hrow .tx b{font-family:var(--fh);font-size:1rem;text-transform:uppercase}
.hrow .rt{text-align:right;flex:none}
.hrow .rt .meta{display:block;margin-top:4px;font-size:.75rem}
.parecer{border-left:4px solid var(--acc);background:var(--bad-bg);padding:10px 12px;margin-top:10px;font-size:.88rem;border-radius:3px}
</style>
</head>
<body>
<div id="app"></div>
<script>
(function(){
  var ITEMS=[
    {c:'OP',q:'Bipar o código de barras da ordem de produção (OP).',hide:true,scan:{key:'op',lab:'Cód. da OP',hint:'bipe o código da OP'}},
    {c:'A',q:'Verificar limpeza da caçamba / balança e encaixotadora.'},
    {c:'B',q:'Verificar código do bag e registrar.',scan:{key:'bag',lab:'Cód. do Bag',hint:'bipe'}},
    {c:'C',q:'Verificar se o produto dentro do bag está correto.'},
    {c:'D',q:'Verificar código da caixa e registrar no campo "Cód.".',scan:{key:'caixa',lab:'Cód. da Caixa',hint:'digite; bipe só se tiver QR'}},
    {c:'E',q:'Verificar código da bobina do filme (arte correta) e registrar.',scan:{key:'filme',lab:'Cód. do Filme (QR Code)',hint:'bipe o QR'}},
    {c:'F',q:'Verificar código do produto e registrar.',scan:{key:'item',lab:'Cód. do Produto (etiqueta)',hint:'bipe ou digite'}},
    {c:'G',q:'Verificar leitura do código de barras e a integridade do código de barras do pacote.',scan:{key:'ean',lab:'Cód. de barras do pacote (EAN13)',hint:'bipe ou digite'}},
    {c:'H',q:'Verificar calibração da balança e peso do produto.'},
    {c:'I',q:'Verificar selagem traseira, superior e inferior.'},
    {c:'J',q:'Verificar resistência do Eurolock (testar leve tração).'},
    {c:'K',q:'Verificar quantidade de peças.'},
    {c:'L',q:'Verificar leitura do código de barras, isento de falhas e o peso.',scan:{key:'dun',lab:'Cód. de barras da caixa (DUN14)',hint:'bipe ou digite'}},
    {c:'M',q:'Verificar calibração da balança dinâmica e peso do produto, comparar com o da etiqueta e registrar.',peso:true},
    {c:'N',q:'Verificar código da etiqueta na Videojet com base no cód. do bag, comparar com peso real e conferir com a base estabelecida.',foto:true},
    {c:'O',q:'Setup conferido e liberado para produção.',final:true}
  ];
  var TURNOS=['1º Turno','2º Turno'];
  var ST={andamento:['Em andamento',''],analise:['Em análise','na'],liberado:['Liberado','ok'],reprovado:['Reprovado','nok']};
  var KEY='checklist-setup-v6',ITKEY='checklist-setup-itens6';
  var DB={oper:'',role:'Operador',seq:0,setups:[]};
  try{var raw=localStorage.getItem(KEY);if(raw){var p=JSON.parse(raw);if(p&&p.setups)DB=p;}}catch(e){}
  function persist(){try{localStorage.setItem(KEY,JSON.stringify(DB));}catch(e){}}
  var S={view:DB.oper?'home':'start',id:null,cur:null,draft:null,msg:'',thumbs:{},q:'',flt:'todos',back:'home',flash:'',cancel:false};
  function cat(){var m={};try{m=JSON.parse(localStorage.getItem(ITKEY)||'{}');}catch(e){}
    if(!m['60693'])m['60693']={itemOp:'60693',desc:'ESPAÇADOR NIVELADOR 1,0 mm (exemplo)',bag:'40062',caixa:'72082',filme:'73587',ean:'7891234560018',dun:'17891234560015'};return m;}
  function saveItem(o){try{var m=cat();m[o.itemOp]=o;localStorage.setItem(ITKEY,JSON.stringify(m));}catch(e){}}
  var app=document.getElementById('app');
  function $(id){return document.getElementById(id);}
  function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m];});}
  function pad(n){return n<10?'0'+n:''+n;}
  function stamp(d){return d.getFullYear()+pad(d.getMonth()+1)+pad(d.getDate())+'-'+pad(d.getHours())+pad(d.getMinutes())+pad(d.getSeconds());}
  function fmt(s){var d=new Date(s);if(isNaN(d))return s;return pad(d.getDate())+'/'+pad(d.getMonth()+1)+'/'+d.getFullYear()+' '+pad(d.getHours())+':'+pad(d.getMinutes());}
  function hm(s){var d=new Date(s);return isNaN(d)?'':pad(d.getHours())+':'+pad(d.getMinutes());}
  function item(c){for(var i=0;i<ITEMS.length;i++)if(ITEMS[i].c===c)return ITEMS[i];}
  function T(){for(var i=0;i<DB.setups.length;i++)if(DB.setups[i].id===S.id)return DB.setups[i];return null;}
  function resp(c,t){t=t||T();return t.ans[c]?t.ans[c].r:null;}
  function answered(t){return ITEMS.filter(function(i){return resp(i.c,t);}).length;}
  function othersDone(t){return ITEMS.every(function(i){return i.final||resp(i.c,t);});}
  function anyNok(t){return ITEMS.some(function(i){return resp(i.c,t)==='Não OK';});}
  function canFinish(t){return othersDone(t)&&resp('O',t)==='Liberado para produção'&&!anyNok(t);}
  function stChip(t){var s=ST[t.status]||ST.andamento;return '<span class="chip '+s[1]+'">'+s[0]+'</span>';}
  function chipOf(a){
    var r=a?a.r:null;
    if(!r)return '<span class="chip">Pendente</span>';
    if(a.quality)return '<span class="chip nok">Qualidade acionada</span>';
    if(a.byQ)return '<span class="chip ok">OK (Qualidade)</span>';
    if(a.conf==='sem'&&r==='OK')return '<span class="chip na">OK · sem referência</span>';
    var cls=r==='OK'||r==='Liberado para produção'?'ok':(r==='Não OK'||r==='Não liberado'?'nok':'na');
    return '<span class="chip '+cls+'">'+esc(r)+'</span>';
  }
  function norm(s){return String(s||'').trim().toUpperCase();}
  function esq(s){return s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');}
  function expList(sc,t){var m={op:[t.op],bag:[t.bag],caixa:[t.caixa],filme:[t.filme],item:[t.itemOp,t.ean],ean:[t.ean,t.itemOp],dun:[t.dun]};
    return (m[sc.key]||[]).filter(Boolean);}
  function semRef(sc,t){return {bag:!t.bag,caixa:!t.caixa,filme:!t.filme,ean:!t.ean,item:!t.ean,dun:!t.dun,op:false}[sc.key];}
  function matches(lido,list){lido=norm(lido);
    return list.some(function(e){e=norm(e);if(lido===e)return true;
      return new RegExp('(^|[^0-9A-Z])'+esq(e)+'($|[^0-9A-Z])').test(lido);});}
  function go(v){S.view=v;if(v!=='view')S.msg='';S.cancel=false;render();window.scrollTo(0,0);}
  function openOf(m){var r=null;DB.setups.forEach(function(t){if(String(t.maq)===String(m)&&(t.status==='andamento'||t.status==='analise')&&(!r||t.dt>r.dt))r=t;});return r;}
  function pending(){return DB.setups.filter(function(t){return t.status==='analise';}).length;}

  function page(step,body,banner){
    var names=['Operador','Setup','Checklist'];
    app.innerHTML='<div class="wrap"><header class="doc"><div><div class="co">CORTAG</div><h1>Checklist início de setup<br>Empacotadoras</h1></div></header>'+
      (step?'<ol class="steps" aria-label="Etapas">'+names.map(function(n,k){var cls=k+1<step?'done':(k+1===step?'cur':'');
        return '<li class="'+cls+'"'+(k+1===step?' aria-current="step"':'')+'><i>'+(k+1<step?'✓':(k+1))+'</i>'+n+'</li>';}).join('')+'</ol>':'')+
      (banner||'')+body+'</div>';
  }

  /* ---------- 1: entrada ---------- */
  function viewStart(){
    var role=DB.role||'Operador';
    page(1,
      '<div class="panel"><h2>Quem está usando?</h2><div class="meta">Identifique-se antes de começar.</div>'+
      '<label for="oper">Código ou nome</label><input id="oper" type="text" autocomplete="off" value="'+esc(DB.oper)+'">'+
      '<label>Perfil <small>(no app final vem do login)</small></label><div class="seg c2" id="segRole">'+['Operador','Qualidade'].map(function(r){return '<button type="button" class="opt" data-r="'+r+'" aria-pressed="'+(r===role)+'">'+r+'</button>';}).join('')+'</div>'+
      '<div id="msg"></div><div class="actions"><button class="btn primary" id="bStart">Entrar</button></div></div>',
      '<div class="note">Protótipo para validar o fluxo com a produção. Os dados ficam só neste navegador e não são gravados em banco.</div>');
    $('segRole').addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;role=b.dataset.r;[].forEach.call(this.children,function(x){x.setAttribute('aria-pressed',x===b?'true':'false');});});
    function start(){var v=$('oper').value.trim();if(!v){$('msg').innerHTML='<div class="hint err">Informe o código ou nome.</div>';return;}DB.oper=v;DB.role=role;persist();go('home');}
    $('bStart').addEventListener('click',start);
    $('oper').addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();start();}});
  }

  /* ---------- painel ---------- */
  var IC={
