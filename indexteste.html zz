    if(t.status==='analise'){
      act=DB.role==='Qualidade'?
        '<div class="panel"><h2>Decisão da Qualidade</h2><label for="par">Parecer <small>(obrigatório)</small></label><textarea id="par"></textarea><div id="pmsg"></div>'+
        '<div class="actions"><button class="btn primary" id="bLib">Liberar e devolver ao operador</button><button class="btn" id="bRep">Reprovar setup</button></div></div>':
        '<div class="hint">Aguardando a Qualidade decidir. O operador não pode alterar este checklist enquanto isso.</div>';
    }
    page(0,'<button class="back" id="bBack">‹ Voltar</button>'+banner+par+summary(t)+act);
    $('bBack').addEventListener('click',function(){S.msg='';go(S.back==='consult'?'consult':'home');});
    function dec(kind){
      var tx=$('par').value.trim();if(!tx){$('pmsg').innerHTML='<div class="hint err">Escreva o parecer.</div>';return;}
      t.pareceres.push({decisao:kind==='lib'?'Liberado pela Qualidade':'Reprovado pela Qualidade',por:DB.oper,em:new Date().toISOString(),texto:tx});
      if(kind==='lib'){
        Object.keys(t.ans).forEach(function(c){var a=t.ans[c];if(a.quality||a.r==='Não OK'){t.ans[c]=Object.assign({},a,{r:'OK',quality:false,byQ:true});}});
        if(resp('O',t)==='Não liberado')delete t.ans.O;
        var base=Object.assign({},cat()[t.itemOp]||{itemOp:t.itemOp,desc:t.desc}),map={B:'bag',D:'caixa',E:'filme',G:'ean',L:'dun'},aprendeu=false;
        Object.keys(map).forEach(function(c){var a=t.ans[c];if(a&&a.conf==='sem'){a.conf=true;a.byQ=true;if(!(c==='G'&&norm(a.cod)===norm(t.itemOp))){base[map[c]]=a.cod;t[map[c]]=a.cod;aprendeu=true;}}});
        if(aprendeu)saveItem(base);
        if(canFinish(t)){t.status='liberado';t.fim=new Date().toISOString();}else t.status='andamento';
      }else{t.status='reprovado';t.fim=new Date().toISOString();}
      persist();S.flash=kind==='lib'?(t.status==='liberado'?'Liberado para produção. Os códigos lidos viraram referência na base.':'Liberado. O operador pode continuar o checklist.'):'Setup reprovado.';go('home');
    }
    if($('bLib')){$('bLib').addEventListener('click',function(){dec('lib');});$('bRep').addEventListener('click',function(){dec('rep');});}
    if(t.status==='andamento'){}
  }

  /* ---------- demonstração (4 máquinas, vários horários) ---------- */
  function seedDemo(){
    if(DB.setups.some(function(t){return t.demo;}))return;
    var items=[
      {itemOp:'62407',desc:'ESPAÇADOR NIVELADOR 1,5 mm ECO (VERMELHO) - C/500 PÇS',bag:'40071',caixa:'72090',filme:'73601',ean:'7891234560025',dun:'17891234560022'},
      {itemOp:'61781',desc:'DESEMP. INOX 6 x 6 / 1/4 x 1/4 in - CABO FDI',bag:'40115',caixa:'72144',filme:'73702',ean:'7891234560032',dun:'17891234560039'},
      {itemOp:'62353',desc:'CUNHA SLIM - PACOTE 100 UN (AUBADE)',bag:'40208',caixa:'72201',filme:'73810',ean:'7891234560049',dun:'17891234560046'}
    ];
    items.forEach(saveItem);
    function mk(maq,turno,op,it,h,m,upto,status,extra){
      var d=new Date();d.setHours(h,m,0,0);var t={id:stamp(d)+'-'+maq,protocolo:++DB.seq,operador:extra&&extra.oper||'Demo',maq:String(maq),turno:turno,op:op,itemOp:it.itemOp,desc:it.desc,bag:it.bag,caixa:it.caixa,filme:it.filme,ean:it.ean,dun:it.dun,dt:d.toISOString(),status:status,ans:{},log:[],pareceres:[],demo:true};
      var ex={OP:t.op,B:t.bag,D:t.caixa,E:t.filme,F:t.itemOp,G:t.ean,L:t.dun};
      ITEMS.slice(0,upto).forEach(function(i){
        var a={r:i.final?'Liberado para produção':'OK',cod:'',conf:null,em:d.toISOString()};
        if(ex[i.c]){a.cod=ex[i.c];a.conf=true;t.log.push({c:i.c,lido:a.cod,esp:a.cod,ok:true,em:d.toISOString(),operador:a.oper});}
        if(i.peso)a.peso='12.4';if(i.foto){a.sem=true;}
        t.ans[i.c]=a;});
      if(status==='liberado'){var f=new Date(d.getTime()+14*60000);t.fim=f.toISOString();}
      if(extra&&extra.flag){t.ans[extra.flag]={r:'Não OK',cod:'99999',conf:false,quality:true,em:d.toISOString()};t.log.push({c:extra.flag,lido:'99999',esp:'',ok:false,em:d.toISOString(),operador:'Demo'});}
      DB.setups.push(t);return t;
    }
    mk(1,'1º Turno','393064',cat()['60693'],6,5,16,'liberado');
    mk(2,'1º Turno','331948',items[1],7,20,16,'liberado');
    mk(1,'1º Turno','393772',items[0],9,40,16,'liberado');
    mk(3,'2º Turno','235659',items[2],14,10,3,'analise',{flag:'B'});
    mk(2,'2º Turno','393772',items[0],14,35,6,'andamento');
    persist();
  }

  function render(){
    if(!DB.oper&&S.view!=='start')S.view='start';
    if((S.view==='list'||S.view==='detail'||S.view==='view')&&!T())S.view='home';
    ({start:viewStart,home:viewHome,setup:viewSetup,list:viewList,detail:viewDetail,consult:viewConsult,view:viewDetailRec})[S.view]();
  }
  render();
})();
</script>
